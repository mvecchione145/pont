# Copy to .env to override the development defaults in docker-compose.yml.
# Change every password before running pont anywhere other than your machine.

# Ports on your machine
PONT_PORT=3000
KEYCLOAK_PORT=8080
MINIO_CONSOLE_PORT=9001

# MinIO (knowledge file store)
MINIO_ROOT_USER=pont
MINIO_ROOT_PASSWORD=pont-minio-dev
MINIO_BUCKET=pont

# Postgres
POSTGRES_PASSWORD=postgres-dev
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-db-dev
PONT_DB_NAME=pont
PONT_DB_USER=pont
PONT_DB_PASSWORD=pont-db-dev

# Keycloak bootstrap admin (creates pont user accounts in the admin console)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Encrypts secrets pont stores (the trivia LLM API key). Use a long random
# value, for example: openssl rand -base64 32
PONT_SECRET_KEY=pont-dev-secret-change-me
